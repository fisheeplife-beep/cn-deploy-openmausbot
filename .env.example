# Local Docker Compose (root compose.yaml semantics from upstream)
# Copy to .env next to docker-compose.yml in this companion, or export in shell.

COMPOSE_PROJECT_NAME=openmausbot
OMB_BIND_ADDRESS=127.0.0.1
OMB_HTTP_PORT=8080
# Leave empty → http://localhost:${OMB_HTTP_PORT}
OMB_PUBLIC_URL=
OMB_WEBHOOK_PUBLIC_URL=
# Tailscale Serve hostname without scheme (requires OMB_BIND_ADDRESS=127.0.0.1)
OMB_HTTPS_HOST=

OMB_BASE_IMAGE=ghcr.io/milind-soni/openmausbot:latest
OMB_LOCAL_IMAGE=openmausbot-local:latest
CADDY_IMAGE=caddy:2

# Space-separated npm engine packages baked at image build; empty skips install.
ENGINES="@anthropic-ai/claude-code @openai/codex"

OMB_DATA_VOLUME=
OMB_DATA_EXTERNAL=false

# --- VPS / own-domain path (upstream deploy/docker-compose.yml) ---
# DOMAIN=maus.example.com
# OMB_SIGNIN_EMAILS=
# OMB_SIGNIN_MEMBER_EMAILS=
